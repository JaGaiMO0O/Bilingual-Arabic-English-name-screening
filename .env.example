# Copy to .env and adjust. Never commit .env.
# Every value here has a working default in src/name_screening/config.py;
# this file exists to document the knobs, not because anything is required.

# --- Model ---
# e5 models require "query: " / "passage: " prefixes. If you swap this for a
# model that does not use them, blank the two prefixes below as well.
NAME_SCREENING_MODEL=intfloat/multilingual-e5-base
NAME_SCREENING_QUERY_PREFIX=query:
NAME_SCREENING_PASSAGE_PREFIX=passage:

# --- Retrieval ---
# Cosine similarity in [-1, 1]. The default is a placeholder: the real value is
# chosen from the precision/recall curve in step 7 and justified in the README.
NAME_SCREENING_MATCH_THRESHOLD=0.85
NAME_SCREENING_TOP_K=10

# --- Paths (relative to the repo root) ---
NAME_SCREENING_DATA_DIR=data
NAME_SCREENING_ARTIFACTS_DIR=artifacts

# --- Batching ---
NAME_SCREENING_EMBED_BATCH_SIZE=64

# --- Hugging Face cache. Set this to keep model weights out of your home dir. ---
# HF_HOME=./hf_cache
